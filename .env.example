# Copie para .env e preencha. O arquivo .env nunca deve ser versionado.

# --- Cliente (expostos no navegador; use apenas chaves publicáveis) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Servidor (nunca use prefixo VITE_ nestes valores) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chave da integração de IA — somente servidor
LOVABLE_API_KEY=

# Chave de criptografia das credenciais de imóveis — somente servidor
CREDENTIALS_ENCRYPTION_KEY=
